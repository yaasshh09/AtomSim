# Origin the app is served from, substituted into index.html's Open Graph tags
# at build time. Empty is correct for a local build: the tags fall back to
# root-relative paths, which most scrapers resolve but none are obliged to.
#
# A shell variable overrides this, which is how the deploy sets it:
#   VITE_SITE_URL=https://atomsim.fly.dev npm run build
VITE_SITE_URL=

# GoatCounter endpoint for visitor counting, e.g.
# https://<code>.goatcounter.com/count. Empty means no counting, which is what
# a local build should do: only the public deployment counts, and fly.toml is
# where the real value lives. See web/src/lib/analytics.ts for what is and is
# not reported.
VITE_GOATCOUNTER=
